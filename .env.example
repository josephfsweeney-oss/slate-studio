# Copy to .env and fill in. Nothing here is committed.

# Where the app listens. BASE_URL must match the redirect URI you register
# with Google, exactly, including the port.
PORT=5173
# Fills itself in on Render and Vercel. Set it only for a custom domain.
# BASE_URL=http://localhost:5173

# EITHER: a service-account key, the whole JSON file on one line, or base64.
# No OAuth client, no consent screen, no browser step. Share the slate folder
# with the account's email as Viewer. Read-only by construction.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# OR: an OAuth client, type "Web application", to read Drive as yourself.
# Authorised redirect URI: <BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The 2026 Slate Decks folder. Already the default; set it only to point
# somewhere else.
# SLATE_DRIVE_FOLDER_ID=1HYMAdrQ4w5vizodC5ICHYzSM0uRUUdAH

# Hosted copies only. Authorise once on your own machine, run `npm run token`,
# and paste the result here. The hosted app then reads Drive as you.
# GOOGLE_REFRESH_TOKEN=

# Where the app keeps the Drive token and the portrait cache. Set this to a
# mounted disk when hosting, or the cache refills on every restart.
# SLATE_STATE_DIR=/var/slate

# Point at the same tree on disk to run with no Google account at all.
# SLATE_LOCAL_DIR="/path/to/2026 Slate Decks"

# The committee whose disclaimer is prefilled. Defaults to the Committee to
# Elect House Republicans. Set this for a deployment serving another committee.
# SLATE_DISCLAIMER=Paid for by ..., address. Treasurer.

# Those routes close themselves when there is no credential behind them, so a
# copy that ships its own portraits is already shut. Set SLATE_PUBLIC=1 anyway
# on any deployment that is not behind a password: it closes the write,
# sign-out, OAuth and refresh routes by declaration and rate limits the rest,
# so adding a credential later cannot reopen them.
# SLATE_PUBLIC=1

# A shared password instead, for a private deployment. A hosted copy reads Drive
# with the account that authorised it, so an open URL hands your Drive reads to
# anybody with the link. One shared password, given to colleagues.
# SLATE_PASSWORD=
